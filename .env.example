APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# OTP
OTP_LENGTH=4
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_TESTING_CODE=1234

#FORJAWALY
FORJAWALY_API_URL=https://api-sms.4jawaly.com/api/v1/account/area/sms/send
FORJAWALY_API_KEY=
FORJAWALY_API_SECRET=
FORJAWALY_SENDER=
# Checkout
CHECKOUT_CURRENCY=SAR
CHECKOUT_TAX_RATE=0.15
CHECKOUT_FREE_DELIVERY=true
CHECKOUT_PRICES_INCLUDE_TAX=false
DELIVERY_INSTANT_ENABLED=true
DELIVERY_INSTANT_FEE=10
DELIVERY_INSTANT_ETA_MIN=30
DELIVERY_INSTANT_ETA_MAX=45
DELIVERY_DAYS_AHEAD=7
DELIVERY_SLOT_LEAD_MINUTES=60

# Tabby
TABBY_ENABLED=true
TABBY_BASE_URL=https://api.tabby.ai
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_IS_TEST=true
TABBY_AUTO_CAPTURE=true
TABBY_WEBHOOK_HEADER=X-Tabby-Auth
TABBY_WEBHOOK_SECRET=
TABBY_APP_RETURN_URL=
# Firebase Cloud Messaging
FCM_ENABLED=true
FCM_CREDENTIALS=storage/app/firebase/service-account.json
FCM_PROJECT_ID=

# Firebase Realtime Database (captain live order feed)
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_DATABASE_URL=
CAPTAIN_FEED_ENABLED=true
CAPTAIN_FEED_PATH=available_orders

# WhatsApp via Evolution API (online gift delivery)
EVOLUTION_ENABLED=true
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Online gifts: link sent to recipients (the claim code is appended as ?gift=CODE)
GIFT_APP_LINK=

# Support contacts ("Contact us" cards) and the inbox receiving contact messages
SUPPORT_EMAIL=support@tahaadoo.sa
SUPPORT_PHONE="+966501234567"
SUPPORT_WHATSAPP="+966501234567"
SUPPORT_INBOX=

# Alshrouq Delivery (custom orders) - staging
ALSHROUQ_BASE_URL=https://staging.alshrouqsse.org/api/integration
ALSHROUQ_API_TOKEN=
ALSHROUQ_PAYMENT_TYPE=3
ALSHROUQ_PREPARATION_TIME=0
ALSHROUQ_STORE_ORDERS=true
ALSHROUQ_WEBHOOK_SECRET=
